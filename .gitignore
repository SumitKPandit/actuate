# ================================
# Actuate — root .gitignore
# Backend: Python / FastAPI / uv | Frontend: Node
# ================================

# ---------- Secrets / env ----------
# Ignore real env files, keep templates
.env
.env.*
!.env.example
!.env.template
*.pem
*.key

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
wheels/

# Virtual envs (uv, venv, virtualenv, conda)
.venv/
venv/
ENV/
env/
.conda/

# uv
.uv/
uv-cache/

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.hypothesis/

# Linters / type checkers
.ruff_cache/
.mypy_cache/
.pyright/
.pyre/

# SQLite (local dev DBs — recreated via init_db)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Node / Frontend ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Builds / outputs
dist/
build/
out/
.next/
.nuxt/
.vuepress/dist/
.vite/
.turbo
*.tsbuildinfo

# Framework caches
.eslintcache
.stylelintcache
.parcel-cache
.rspack-cache

# Testing / coverage (JS)
coverage/

# ---------- OS ----------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ---------- IDE / editors ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.default
.idea/
*.swp
*.swo
*.swn
.project
.classpath
*.sublime-workspace
*.sublime-project

# ---------- Logs / tmp ----------
logs/
*.log
tmp/
temp/
*.tmp
*.bak
*.orig

# ---------- Local misc ----------
*.local
