# Copy to `.env` and adjust as needed.
APP_NAME="Actuate API"
# Local default (zero setup):
DATABASE_URL="sqlite+aiosqlite:///./actuate.db"
# When deployed, use PostgreSQL instead:
# DATABASE_URL="postgresql+asyncpg://actuate:actuate@localhost:5432/actuate"
# Embeddings use sentence-transformers/all-MiniLM-L6-v2 (384 dimensions).
# Browser origins allowed by CORS (JSON array):
# CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
